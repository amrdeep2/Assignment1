@model List<Assignment1.Models.Event>

@{
    ViewData["Title"] = ViewData["Title"] ?? "Event Manager";
    var eventCount = (int)(ViewData["EventCount"] ?? 0);
}

<h1>Event Manager</h1>
<p>Total Events: <strong>@eventCount</strong></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th>Attendees</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ev in Model)
        {
            <tr>
                <td>@ev.title</td>
                <td>@ev.Date.ToString("yyyy-MM-dd")</td>
                <td>@ev.Location</td>
                <td>@(ev.Attendees == null ? 0 : ev.Attendees.Count)</td>
                <td>
                    <a class="btn btn-primary"
                       asp-controller="EventManager"
                       asp-action="ManageAttendees"
                       asp-route-id="@ev.id">
                        Manage Attendees
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
