@model List<Assignment1.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h1>Event Manager</h1>

@if (User.IsInRole("Organizer"))
{
    <p>
        <a asp-controller="EventManager" asp-action="Create" class="btn btn-primary">Create New Event</a>
    </p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ev in Model)
        {
            <tr>
                <td>@ev.Title</td>
                <td>@ev.Date.ToString("yyyy-MM-dd hh:mm tt")</td>
                <td>@ev.Location</td>
                <td>
                    <a asp-controller="EventManager" asp-action="Details" asp-route-id="@ev.Id">View</a>

                    @if (User.IsInRole("Organizer"))
                    {
                        <text> | </text>
                        <a asp-controller="EventManager" asp-action="Edit" asp-route-id="@ev.Id">Edit</a>
                        <text> | </text>
                        <a asp-controller="EventManager" asp-action="Delete" asp-route-id="@ev.Id">Delete</a>
                        <text> | </text>
                        <a asp-controller="EventManager" asp-action="ManageAttendees" asp-route-id="@ev.Id">Register</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>