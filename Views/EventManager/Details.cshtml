@model Assignment1.Models.Event

<h1>@Model.Title</h1>

<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Date:</strong> @Model.Date.ToString("yyyy-MM-dd")</p>
<p><strong>Location:</strong> @Model.Location</p>

@if (!string.IsNullOrEmpty(Model.BannerUrl))
{
    <img src="@Model.BannerUrl" alt="Banner" class="img-fluid mb-3" style="max-height:300px;" />
}

<h3>Attendees</h3>

@if (Model.Attendees != null && Model.Attendees.Any())
{
    <ul>
        @foreach (var a in Model.Attendees)
        {
            <li>@a.Name (@a.Email)</li>
        }
    </ul>
}
else
{
    <p>No attendees yet.</p>
}

<a asp-action="Index" class="btn btn-secondary">Back</a>