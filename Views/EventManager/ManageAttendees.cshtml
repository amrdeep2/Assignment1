@model Assignment1.Models.Event

@{
    var eventName = (string)(ViewData["EventName"] ?? Model.Title);
    var error = ViewData["Error"] as string;
}

<h1>Manage Attendees</h1>
<h3>Event: <strong>@eventName</strong></h3>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (!string.IsNullOrEmpty(Model.BannerUrl))
{
    <img src="@Model.BannerUrl" alt="Banner" class="img-fluid mb-3" style="max-height:250px;" />
}

<hr />

@if (User.IsInRole("Organizer"))
{
    <h4>Add Attendee</h4>

    <form asp-action="ManageAttendees" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input class="form-control" name="name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" name="email" />
        </div>

        <button type="submit" class="btn btn-success">Add Attendee</button>
        <a class="btn btn-secondary" asp-action="Index">Back to Events</a>
    </form>
}

<hr />

<h4>Attendees List (@(Model.Attendees == null ? 0 : Model.Attendees.Count))</h4>

@if (Model.Attendees == null || !Model.Attendees.Any())
{
    <p>No attendees registered yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Email</th>
                @if (User.IsInRole("Organizer"))
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
            }
            @foreach (var a in Model.Attendees)
            {
                <tr>
                    <td>@i</td>
                    <td>@a.Name</td>
                    <td>@a.Email</td>
                    @if (User.IsInRole("Organizer"))
                    {
                        <td>
                            <a asp-action="RemoveAttendee"
                               asp-route-id="@Model.Id"
                               asp-route-attendeeId="@a.Id"
                               class="btn btn-danger btn-sm">Remove</a>
                        </td>
                    }
                </tr>
                i++;
            }
        </tbody>
    </table>
}